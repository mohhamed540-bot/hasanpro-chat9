# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SERVER_URL: Optional Backend Server URL for WebSockets & Socket.IO
# (Required ONLY if hosting frontend separately on static/serverless platforms like Vercel or Netlify)
# Example: https://my-chat-server.onrender.com or https://ais-pre-ip7lllumw4woqjvrjoqo2b-308497405360.europe-west2.run.app
VITE_SERVER_URL=""

# ==============================================================================
# 🗄️ EXTERNAL DATABASE CONFIGURATION (إعدادات قاعدة البيانات السحابية الخارجية)
# Database-Agnostic: Works with any external cloud database or REST sync service.
# If omitted, the system seamlessly uses high-performance local persistent files.
# ==============================================================================

# DATABASE_URL: General connection URL or REST sync endpoint for the database
# Example: https://my-cloud-db.example.com/api/v1 or postgres://user:pass@host:5432/dbname
DATABASE_URL=""

# DATABASE_TYPE: Database driver type ('auto', 'cloud_rest', 'database_url', 'local_json', 'memory')
DATABASE_TYPE="auto"

# DATABASE_API_KEY: Secret API key for authenticating with the external cloud database
DATABASE_API_KEY=""

# DATABASE_AUTH_TOKEN: Bearer token for authenticating with the external database
DATABASE_AUTH_TOKEN=""

# DATABASE_SYNC_INTERVAL_MS: Background cloud synchronization interval in milliseconds
DATABASE_SYNC_INTERVAL_MS="5000"


# ==============================================================================
# ☁️ EXTERNAL MEDIA & CLOUD STORAGE (إعدادات التخزين السحابي للصور والوسائط)
# Storage-Agnostic: Works with any cloud storage provider (S3, Cloudinary, Supabase, etc.)
# If omitted, the server stores media locally in the `/uploads` directory.
# ==============================================================================

# STORAGE_PROVIDER: 'local' | 's3_compatible' | 'cloudinary' | 'supabase' | 'custom_http'
STORAGE_PROVIDER="local"

# STORAGE_ENDPOINT: External upload webhook or cloud storage API endpoint URL
STORAGE_ENDPOINT=""

# STORAGE_BUCKET: Bucket name (e.g. AWS S3 bucket, Cloudflare R2 bucket, Supabase bucket)
STORAGE_BUCKET=""

# STORAGE_REGION: Cloud storage region (e.g. 'us-east-1', 'eu-central-1', 'auto')
STORAGE_REGION="auto"

# STORAGE_ACCESS_KEY: Access Key ID or client ID for cloud storage
STORAGE_ACCESS_KEY=""

# STORAGE_SECRET_KEY: Secret Access Key for cloud storage
STORAGE_SECRET_KEY=""

# STORAGE_AUTH_TOKEN: Bearer / Auth Token for custom HTTP upload endpoints
STORAGE_AUTH_TOKEN=""

# STORAGE_PUBLIC_URL_PREFIX: Custom domain or CDN URL prefix for serving uploaded media
# Example: https://cdn.example.com/media
STORAGE_PUBLIC_URL_PREFIX=""
